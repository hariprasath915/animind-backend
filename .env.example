# ── Google OAuth ────────────────────────────────────────────────────────
# Client ID + Secret go into Supabase Dashboard → Authentication → Providers → Google
# NOT here — the backend never sees them directly.
#
# GOOGLE_CLIENT_ID     → paste in Supabase Dashboard (not here)
# GOOGLE_CLIENT_SECRET → paste in Supabase Dashboard (not here)
#
# Google Cloud Console → APIs & Services → Credentials → OAuth Client
# Authorized redirect URIs must include:
#   https://fkincmzpteuibbegghti.supabase.co/auth/v1/callback
#
# Supabase Dashboard → Authentication → URL Configuration → Redirect URLs must include:
#   https://genzet-app.vercel.app/oauth_callback.html
#
# Override GOOGLE_OAUTH_CALLBACK_URL if your frontend URL is different:
GOOGLE_OAUTH_CALLBACK_URL=https://genzet-app.vercel.app/oauth_callback.html
