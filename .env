
# GenZet Backend — Environment Variables
# ========================================
# Copy this file to .env and fill in your real values.
# NEVER commit .env to git.

# ── Anthropic Claude API ──────────────────────────────────────────────
ANTHROPIC_API_KEY=
# ── JWT Authentication ────────────────────────────────────────────────
# Generate a strong secret key with:
#   python -c "import secrets; print(secrets.token_hex(64))"
JWT_SECRET_KEY=c2c6bc5749f4c2c229d1a6890adfbed3200d0b8a870f821ee9d42a9a5e801c000737d35b052dc47e6ee627690813bec3e3eb4991e93b93ef6640c13ca539d270

# Token expiry in days (default: 900)
JWT_EXPIRE_DAYS=900

# ── Database ───────────────────────────────────────────────────────────
# SQLite (default — no setup required, file created automatically):
DATABASE_URL=postgresql://genzet_user:strongpassword@db.yourschool.com:5432/genzet_db

# PostgreSQL (for production deployment):
# DATABASE_URL=postgresql://username:password@localhost:5432/genzet_db

# ── Backend server ─────────────────────────────────────────────────────
# The URL that your frontend sends requests to.
# During development: http://localhost:8000
# In production: https://your-api-domain.com
BACKEND_URL=http://localhost:8000
